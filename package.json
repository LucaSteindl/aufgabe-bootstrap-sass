{
  "name": "bootstrap-sass-project",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "scss:build": "sass src/scss/style.scss dist/css/style.css --no-source-map",
    "scss:watch": "sass --watch --poll src/scss:dist/css --no-source-map",
    "serve": "browser-sync start --server . --files \"**/*.html\" \"dist/css/*.css\" --no-ui"
  },
  "keywords": [],
  "type": "commonjs",
  "dependencies": {
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.2"
  },
  "devDependencies": {
    "browser-sync": "^3.0.4",
    "sass": "^1.108.1"
  }
}
